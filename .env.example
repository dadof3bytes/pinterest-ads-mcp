# Pinterest developer app
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/oauth/pinterest

# Single ad account for this deployment
PINTEREST_AD_ACCOUNT_ID=

# Use Pinterest sandbox API (token exchange uses api-sandbox.pinterest.com)
PINTEREST_USE_SANDBOX=true

# OAuth refresh token (choose one storage method)
# Plain refresh token (dev only)
# PINTEREST_REFRESH_TOKEN=
# Or encrypted blob + key
# PINTEREST_REFRESH_TOKEN_ENCRYPTED=
TOKEN_ENCRYPTION_KEY=

# MCP HTTP protection (optional on localhost without header)
MCP_AUTH_TOKEN=

# Signed mutation drafts (defaults to TOKEN_ENCRYPTION_KEY)
DRAFT_SIGNING_SECRET=

# OAuth CSRF state HMAC
OAUTH_STATE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
